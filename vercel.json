{
  "redirects": [
    {
      "source": "/downloads/1.0.0/PackageGuard-Setup.exe",
      "destination": "https://github.com/nsakthivel-dev/Package-Guard/releases/download/v1.0.0/PackageGuard-Setup.exe",
      "permanent": false
    },
    {
      "source": "/downloads/1.0.0/PackageGuard-1.0.0-x64.msi",
      "destination": "https://github.com/nsakthivel-dev/Package-Guard/releases/download/v1.0.0/PackageGuard-1.0.0-x64.msi",
      "permanent": false
    },
    {
      "source": "/downloads/1.0.0/PackageGuard-Setup.msi",
      "destination": "https://github.com/nsakthivel-dev/Package-Guard/releases/download/v1.0.0/PackageGuard-1.0.0-x64.msi",
      "permanent": false
    },
    {
      "source": "/downloads/1.0.0/PackageGuard-1.0.0-x64.msix",
      "destination": "https://github.com/nsakthivel-dev/Package-Guard/releases/download/v1.0.0/PackageGuard-1.0.0-x64.msix",
      "permanent": false
    },
    {
      "source": "/downloads/1.0.0/PackageGuard-Setup.msix",
      "destination": "https://github.com/nsakthivel-dev/Package-Guard/releases/download/v1.0.0/PackageGuard-1.0.0-x64.msix",
      "permanent": false
    },
    {
      "source": "/downloads/:version/:filename",
      "destination": "https://github.com/nsakthivel-dev/Package-Guard/releases/download/v:version/:filename",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
